# ---------------------------------------------------------------------------
# NEXUS.GG - variaveis de ambiente
# Copie este arquivo para ".env" e ajuste o que precisar:  cp .env.example .env
# ---------------------------------------------------------------------------

# --- Servidor ---------------------------------------------------------------
# Porta HTTP. Em producao, normalmente atras de um proxy reverso.
PORT=3000
# "development" (padrao) ou "production".
NODE_ENV=development

# --- Loja -------------------------------------------------------------------
LOJA_NOME=NEXUS.GG
# Usado em links absolutos (sem barra no final).
LOJA_URL=http://localhost:3000

# --- Banco de dados ---------------------------------------------------------
# Caminho do arquivo SQLite. A pasta e criada automaticamente.
# Ex.: BANCO_ARQUIVO=./dados/nexus.db  |  /var/lib/nexus/nexus.db
BANCO_ARQUIVO=./dados/nexus.db

# --- Sessao -----------------------------------------------------------------
# Validade do cookie "lembrar-me", em dias.
SESSAO_DIAS=7
# Segredo usado para assinar dados internos (TROQUE em producao!).
# Gere com:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SEGREDO_APP=troque-este-segredo-em-producao

# --- CORS -------------------------------------------------------------------
# Origens extras liberadas, separadas por virgula. Vazio = somente o proprio site.
CORS_ORIGIN=

# --- Administracao ----------------------------------------------------------
# E-mails promovidos a administrador automaticamente (separados por virgula).
ADMIN_EMAILS=

# --- Pagamento (simulado) ---------------------------------------------------
# Provedor de pagamento. "simulado" aprova na hora, sem chamada externa.
PAGAMENTO_PROVEDOR=simulado
# Metodo padrao quando o cliente nao informa: pix | cartao | boleto
PAGAMENTO_METODO_PADRAO=pix

# --- Observabilidade --------------------------------------------------------
# Nivel minimo de log: debug | info | warn | error | silent
LOG_NIVEL=info
# De quem o X-Forwarded-For e aceito (base do IP no rate limit e na auditoria).
#   vazio        -> loopback: so proxy na mesma maquina (padrao seguro)
#   false        -> sem proxy: o cabecalho e ignorado
#   1, 2...      -> numero de proxies na frente (Heroku/Render = 1)
#   lista        -> IPs/CIDRs do proxy, ex.: loopback,10.0.0.0/8
# "true" equivale a 1 (o "true" cru do Express deixaria qualquer um forjar o IP).
TRUST_PROXY=

# --- Protecao contra abuso --------------------------------------------------
# Limite geral de requisicoes por minuto, por IP, nas rotas /api.
RATE_LIMIT_GERAL=300
# Limite de tentativas de login/cadastro por janela de 15 minutos.
RATE_LIMIT_AUTH=10
