{
  "name": "nexus-gg",
  "version": "2.0.0",
  "description": "NEXUS.GG - loja de licencas digitais com entrega automatica. Backend completo em Express + SQLite.",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --test \"testes/*.test.js\"",
    "build": "node scripts/build.js",
    "pack": "node scripts/build.js && node scripts/pacotar.js",
    "rebuild": "npm rebuild better-sqlite3",
    "db:migrate": "node scripts/migrar.js",
    "db:seed": "node scripts/semear.js",
    "db:reset": "node scripts/reiniciar.js"
  },
  "keywords": [
    "vendas",
    "express",
    "sqlite",
    "ecommerce",
    "licencas"
  ],
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dayjs": "^1.11.10",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "nodemon": "^3.1.0"
  },
  "allowScripts": {
    "better-sqlite3": true
  }
}
